
---
const technologies = [
  "JavaScript",
  "React",
  "Astro",
  "Power Platform",
  "AWS",
];

const projects = [
  {
    number: "01",
    category: "AUTOMATIZACIÓN",
    title: "Gestión de procesos",
    description:
      "Soluciones digitales para organizar información, centralizar registros y optimizar tareas de trabajo.",
    technologies: ["Power Apps", "SharePoint", "Power Automate"],
    type: "POWER PLATFORM",
    icon: "{ }",
    theme: "purple",
    href: "#contacto",
    action: "CONSULTAR PROYECTO",
  },
  {
    number: "02",
    category: "VISUALIZACIÓN",
    title: "Dashboard de indicadores",
    description:
      "Organización y visualización de datos para facilitar el análisis, el seguimiento de resultados y la toma de decisiones.",
    technologies: ["Power BI", "Excel", "Datos"],
    type: "DATA ANALYTICS",
    icon: "▥",
    theme: "mint",
    href: "#contacto",
    action: "CONSULTAR PROYECTO",
  },
  {
    number: "03",
    category: "INTERNET DE LAS COSAS",
    title: "Monitor de plantas IoT",
    description:
      "Proyecto personal en desarrollo para monitorear estados de equipos mediante AWS IoT Core y preparar notificaciones por WhatsApp.",
    technologies: ["AWS IoT Core", "MQTT", "JavaScript"],
    type: "EN DESARROLLO",
    icon: "⌁",
    theme: "yellow",
    href: "#contacto",
    action: "CONSULTAR PROYECTO",
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f4ed" />
    <meta
      name="description"
      content="Portafolio de César González, creador de soluciones digitales, automatizaciones y experimentos tecnológicos."
    />
    <title>César González | Developer Arcade</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="pixel-sky" aria-hidden="true"></div>

    <header class="topbar">
      <a class="brand" href="#inicio" aria-label="Ir al inicio">
        <span class="brand-icon">CG</span>
        <span>CESAR<span class="brand-dot">.EXE</span></span>
      </a>

      <nav aria-label="Navegación principal">
        <a href="#sobre-mi">Sobre mí</a>
        <a href="#proyectos">Proyectos</a>
        <a href="#habilidades">Habilidades</a>
        <a class="nav-contact" href="#contacto">Hablemos ↗</a>
      </nav>
    </header>

    <main>
      <!-- INICIO -->
      <section class="hero section-wrap" id="inicio">
        <div class="hero-copy">
          <div class="status-label">
            <span class="status-dot"></span>
            PORTAFOLIO EN CONSTRUCCIÓN
          </div>

          <p class="eyebrow">¡HOLA, MUNDO! SOY</p>

          <h1 class="hero-title arcade-title">CÉSAR<br /><span>GONZÁLEZ.</span></h1>

          <p class="hero-description">
            Me gusta explorar la tecnología, automatizar tareas y convertir
            ideas en soluciones digitales que tengan un propósito.
          </p>

          <div class="hero-actions">
            <a class="button button-primary" href="#proyectos">
              ▶ VER PROYECTOS
            </a>
            <a class="button button-secondary" href="#sobre-mi">
              CONOCERME
            </a>
          </div>

          <div class="hero-footnote">
            <span class="tiny-star">✳</span>
            <span>CONSTRUYENDO COSAS INTERESANTES, UN PIXEL A LA VEZ.</span>
          </div>
        </div>

        <!-- ESCENA PIXEL ART -->
        <div
          class="character-scene"
          aria-label="Ilustración pixel art de un personaje desarrollador"
        >
          <div class="scene-label">
            PLAYER 001 <span>● ONLINE</span>
          </div>

          <div class="sun-disc"></div>
          <div class="pixel-star star-one">✦</div>
          <div class="pixel-star star-two">✳</div>
          <div class="pixel-star star-three">✦</div>

          <div class="speech-bubble">
            ¡HOLA!<br />SOY CÉSAR <span>↙</span>
          </div>

          <div class="avatar avatar-art">
            <svg
              viewBox="0 0 160 240"
              xmlns="http://www.w3.org/2000/svg"
              role="img"
              aria-label="Personaje pixel art de César"
              shape-rendering="crispEdges"
            >
              <!-- Cabello -->
              <g fill="#382b32">
                <path
                  d="M36 42V26H44V18H56V14H92V18H108V26H116V38H124V62H116V70H108V54H100V42H92V34H72V38H60V46H48V62H40V78H32V58H36Z"
                />
                <rect x="44" y="10" width="12" height="8" />
                <rect x="56" y="6" width="12" height="8" />
                <rect x="68" y="10" width="20" height="8" />
                <rect x="88" y="14" width="12" height="8" />
                <rect x="100" y="22" width="8" height="8" />
              </g>

              <g fill="#59404a">
                <rect x="44" y="26" width="12" height="8" />
                <rect x="56" y="18" width="12" height="8" />
                <rect x="76" y="18" width="16" height="8" />
                <rect x="92" y="26" width="12" height="8" />
                <rect x="36" y="42" width="8" height="16" />
              </g>

              <!-- Orejas -->
              <g fill="#d99770">
                <rect x="36" y="70" width="12" height="20" />
                <rect x="112" y="70" width="12" height="20" />
              </g>

              <g fill="#b96e56">
                <rect x="40" y="78" width="4" height="8" />
                <rect x="116" y="78" width="4" height="8" />
              </g>

              <!-- Rostro -->
              <path
                fill="#e9aa7d"
                d="M48 38H108V46H116V62H120V90H112V106H104V114H96V122H64V114H56V106H48V98H44V62H48Z"
              />

              <path
                fill="#f4c39a"
                d="M52 46H96V50H104V62H108V86H104V98H96V106H76V102H64V94H56V78H52Z"
              />

              <path
                fill="#d99770"
                d="M104 54H112V90H104V102H96V110H80V114H96V106H104V98H112V90H116V62H108V46H104Z"
              />

              <!-- Flequillo -->
              <g fill="#382b32">
                <path
                  d="M40 42H52V34H64V30H80V34H92V38H108V46H116V58H108V54H96V46H84V42H72V46H60V54H48V66H40Z"
                />
                <rect x="48" y="54" width="8" height="8" />
                <rect x="60" y="46" width="8" height="8" />
                <rect x="72" y="42" width="8" height="8" />
                <rect x="84" y="46" width="8" height="8" />
              </g>

              <g fill="#59404a">
                <rect x="52" y="38" width="12" height="4" />
                <rect x="68" y="34" width="12" height="4" />
                <rect x="88" y="42" width="12" height="4" />
              </g>

              <!-- Cejas y ojos -->
              <g fill="#382b32">
                <rect x="52" y="70" width="20" height="4" />
                <rect x="88" y="70" width="20" height="4" />
                <rect x="56" y="78" width="12" height="12" />
                <rect x="92" y="78" width="12" height="12" />
              </g>

              <g fill="#fff3df">
                <rect x="60" y="78" width="4" height="4" />
                <rect x="96" y="78" width="4" height="4" />
              </g>

              <!-- Nariz, mejillas y sonrisa -->
              <g fill="#d99770">
                <rect x="76" y="82" width="8" height="12" />
                <rect x="72" y="94" width="12" height="4" />
              </g>

              <g fill="#df8580">
                <rect x="48" y="90" width="12" height="4" />
                <rect x="52" y="94" width="12" height="4" />
                <rect x="100" y="90" width="12" height="4" />
                <rect x="96" y="94" width="12" height="4" />
              </g>

              <g fill="#75433f">
                <rect x="68" y="102" width="24" height="4" />
                <rect x="72" y="106" width="16" height="4" />
              </g>

              <rect x="72" y="102" width="16" height="4" fill="#fff3df" />

              <!-- Cuello -->
              <path fill="#d99770" d="M64 114H96V138H64Z" />
              <rect x="64" y="114" width="32" height="8" fill="#b96e56" />

              <!-- Brazos -->
              <path
                fill="#e9aa7d"
                d="M36 150H52V194H44V202H28V190H32V166H36Z"
              />

              <path
                fill="#e9aa7d"
                d="M108 150H124V166H128V190H132V202H116V194H108Z"
              />

              <g fill="#d99770">
                <rect x="28" y="194" width="16" height="8" />
                <rect x="116" y="194" width="16" height="8" />
              </g>

              <!-- Camiseta morada -->
              <path
                fill="#5036ae"
                d="M56 130H68V138H92V130H104L124 146L112 166H104V218H56V166H48L36 146Z"
              />

              <path
                fill="#7254d8"
                d="M56 138H68V146H76V154H84V146H92V138H100L112 150H104V174H96V210H64V174H56V150H48Z"
              />

              <g fill="#8d75e8">
                <rect x="60" y="150" width="8" height="8" />
                <rect x="68" y="158" width="8" height="8" />
                <rect x="84" y="158" width="8" height="8" />
                <rect x="92" y="150" width="8" height="8" />
              </g>

              <rect x="68" y="174" width="24" height="24" fill="#fff3df" />

              <text
                x="80"
                y="190"
                text-anchor="middle"
                font-size="12"
                font-family="monospace"
                font-weight="bold"
                fill="#5036ae"
              >CG</text>

              <g fill="#5036ae">
                <rect x="40" y="150" width="8" height="12" />
                <rect x="112" y="150" width="8" height="12" />
              </g>
            </svg>
          </div>

          <div class="mini-window">
            <div class="window-bar">
              <span>my_profile.txt</span>
              <span>− □ ×</span>
            </div>
            <div class="window-content">
              <p><span>01</span> curiosidad = true;</p>
              <p><span>02</span> crear_ideas();</p>
              <p><span>03</span> <b>_</b></p>
            </div>
          </div>

          <div class="scene-ground"></div>
          <div class="scene-caption">FIG. 001 — THE DIGITAL EXPLORER</div>
        </div>
      </section>

      <!-- CINTA DE TECNOLOGÍAS -->
      <section class="ticker" aria-label="Tecnologías de interés">
        <div class="ticker-track">
          {technologies.map((technology) => (
            <span class="ticker-item" aria-hidden="true">
              <span>✳</span> {technology}
            </span>
          ))}
          {technologies.map((technology) => (
            <span class="ticker-item" aria-hidden="true">
              <span>✳</span> {technology}
            </span>
          ))}
        </div>
      </section>

      <!-- SOBRE MÍ -->
      <section class="content-section section-wrap" id="sobre-mi">
        <p class="section-kicker">01 / EL JUGADOR DETRÁS DE LA PANTALLA</p>
        <h2>Un poco sobre <span>mí.</span></h2>

        <div class="about-card">
          <div class="about-icon" aria-hidden="true">👾</div>

          <div class="about-copy">
            <h3>Curioso por naturaleza.</h3>
            <p>
              Disfruto descubrir herramientas, aprender nuevas tecnologías
              y encontrar maneras de hacer que el trabajo cotidiano sea más
              sencillo. Me interesa crear soluciones útiles, explorar ideas
              y aprender constantemente a través de proyectos.
            </p>
          </div>

          <span class="card-stamp">LV. 01</span>
        </div>
      </section>

      <!-- PROYECTOS -->
      <section class="projects-section section-wrap" id="proyectos">
        <div class="section-heading">
          <p class="section-kicker">02 / SELECT YOUR LEVEL</p>
          <h2>Misiones y <span>proyectos.</span></h2>
          <p class="section-intro">
            Soluciones digitales, experimentos tecnológicos y nuevas ideas
            que voy convirtiendo en proyectos.
          </p>
        </div>

        <div class="projects-grid">
          {projects.map((project) => (
            <article class="project-card">
              <div class={`project-preview preview-${project.theme}`}>
                <span class="project-number">MISSION_{project.number}</span>

                <div class="pixel-art-icon" aria-hidden="true">
                  {project.icon}
                </div>

                <span class="project-status">{project.type}</span>
              </div>

              <div class="project-content">
                <p class="project-type">
                  {project.number} // {project.category}
                </p>

                <h3>{project.title}</h3>
                <p class="project-description">{project.description}</p>

                <div class="project-tech">
                  {project.technologies.map((technology) => (
                    <span>{technology}</span>
                  ))}
                </div>

                <a class="project-link" href={project.href}>
                  <span>{project.action}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          ))}
        </div>

        <p class="projects-footnote">
          <span aria-hidden="true">★</span>
          MÁS PROYECTOS, MÁS EXPERIENCIA, MÁS NIVELES POR DESBLOQUEAR.
        </p>
      </section>

      <!-- HABILIDADES -->
      <section class="content-section section-wrap" id="habilidades">
        <p class="section-kicker">03 / INVENTARIO</p>
        <h2>Mis herramientas <span>favoritas.</span></h2>

        <div class="skills-grid">
          {technologies.map((technology, index) => (
            <div class="skill-card">
              <span class="skill-number">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="skill-name">{technology}</span>
              <span class="skill-symbol" aria-hidden="true">✳</span>
            </div>
          ))}
        </div>

        <p class="skills-note">
          Inventario tecnológico en evolución. Las herramientas mostradas
          representan áreas de interés y trabajo que puedes ampliar con
          proyectos y experiencias concretas.
        </p>
      </section>

      <!-- CONTACTO -->
      <section class="contact-section section-wrap" id="contacto">
        <div class="contact-card">
          <span class="section-kicker">04 / FIN DE NIVEL... ¿O INICIO?</span>
          <h2>¿Hacemos algo <span>genial?</span></h2>

          <p>
            Estoy abierto a conversar sobre tecnología, soluciones digitales,
            proyectos y nuevas oportunidades.
          </p>

          <a
            class="button button-primary"
            href="https://github.com/Cesardgp"
            target="_blank"
            rel="noopener noreferrer"
          >
            EXPLORAR MI GITHUB ↗
          </a>
        </div>
      </section>
    </main>

    <!-- PIE DE PÁGINA -->
    <footer>
      <a class="brand footer-brand" href="#inicio">
        CG<span class="brand-dot">.EXE</span>
      </a>

      <span>HECHO CON CURIOSIDAD Y MUCHOS PÍXELES.</span>

      <a href="#inicio">VOLVER ARRIBA ↑</a>
    </footer>
  </body>
</html>

<style>
  :root {
    font-family: "DM Sans", sans-serif;
    color: #242238;
    background: #f8f4ed;
    font-synthesis: none;
    text-rendering: optimizeLegibility;

    --ink: #242238;
    --purple: #7254d8;
    --purple-dark: #5036ae;
    --mint: #b8f0d3;
    --paper: #fffdf8;
    --line: #ded7ca;
    --muted: #686477;
    --lavender: #e9e2ff;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 95px;
  }

  body {
    margin: 0;
    min-width: 320px;
    overflow-x: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a,
  button {
    -webkit-tap-highlight-color: transparent;
  }

  ::selection {
    color: var(--ink);
    background: var(--mint);
  }

  .pixel-sky {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.34;
    background-image: radial-gradient(#b9b0a3 1px, transparent 1px);
    background-size: 18px 18px;
    mask-image: linear-gradient(to bottom, black, transparent 75%);
  }

  /* NAVEGACIÓN */

  .topbar {
    min-height: 76px;
    padding: 12px 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1px solid var(--line);
    background: rgba(248, 244, 237, 0.94);
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(12px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    font-weight: 800;
    letter-spacing: -0.6px;
    font-size: 15px;
  }

  .brand-icon {
    display: grid;
    place-items: center;
    width: 35px;
    height: 35px;
    background: var(--purple);
    color: white;
    border: 2px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    font-size: 12px;
  }

  .brand-dot {
    color: var(--purple);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 13px;
    font-weight: 700;
  }

  nav a {
    transition: color 0.2s;
  }

  nav a:hover {
    color: var(--purple);
  }

  .nav-contact {
    border: 2px solid var(--ink);
    padding: 10px 14px;
    box-shadow: 3px 3px 0 var(--ink);
    background: var(--paper);
  }

  /* BASE */

  .section-wrap {
    width: min(1100px, 86%);
    margin-inline: auto;
  }

  .status-label,
  .eyebrow,
  .section-kicker,
  .hero-footnote,
  .scene-label,
  .scene-caption,
  footer > span,
  footer > a:last-child,
  .skill-number,
  .window-content,
  .button {
    font-family: "Press Start 2P", monospace;
  }

  h1 span,
  h2 span {
    color: var(--purple);
  }

  h2 {
    margin: 17px 0 30px;
    font-size: clamp(29px, 4vw, 43px);
    line-height: 1.3;
    letter-spacing: -1.7px;
  }

  /* HERO */

  .hero {
    min-height: 590px;
    padding-top: 78px;
    padding-bottom: 75px;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 55px;
  }

  .status-label {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 10px 12px;
    border: 1px solid #c7ddcc;
    background: #e8f7ed;
    color: #34694d;
    font-size: 8px;
    line-height: 1.7;
    margin-bottom: 28px;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #4ba76a;
    animation: status-pulse 1.8s infinite;
  }

  @keyframes status-pulse {
    50% {
      opacity: 0.35;
    }
  }

  .eyebrow {
    font-size: 10px;
    letter-spacing: 1px;
    margin: 0 0 14px;
  }

  h1 {
    margin: 0;
    font-size: clamp(38px, 5.2vw, 68px);
    line-height: 1.15;
    letter-spacing: -3px;
    font-weight: 800;
  }

  .hero-description {
    max-width: 460px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.9;
    margin: 24px 0 27px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
  }

  .button {
    min-height: 49px;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 15px 18px;
    border: 2px solid var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
    font-size: 9px;
    line-height: 1.8;
    text-align: center;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .button:hover {
    transform: translate(3px, 3px);
    box-shadow: 1px 1px 0 var(--ink);
  }

  .button-primary {
    background: var(--purple);
    color: white;
  }

  .button-primary:hover {
    background: var(--purple-dark);
  }

  .button-secondary {
    background: var(--paper);
  }

  .hero-footnote {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 37px;
    color: #898397;
    font-size: 7px;
    line-height: 2.2;
  }

  .tiny-star {
    color: #df8e4c;
    font-size: 20px;
    flex-shrink: 0;
  }

  /* ESCENA PIXEL ART */

  .character-scene {
    height: 420px;
    position: relative;
    overflow: hidden;
    background: var(--lavender);
    border: 2px solid var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
    isolation: isolate;
  }

  .scene-label {
    position: absolute;
    z-index: 3;
    top: 14px;
    left: 14px;
    right: 14px;
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-size: 7px;
    line-height: 1.8;
  }

  .scene-label span {
    color: #31865b;
  }

  .sun-disc {
    position: absolute;
    width: 185px;
    height: 185px;
    border-radius: 50%;
    background: #f9d990;
    top: 70px;
    left: 50%;
    transform: translateX(-50%);
  }

  .pixel-star {
    position: absolute;
    color: var(--purple);
    font-size: 24px;
  }

  .star-one {
    top: 105px;
    left: 35px;
  }

  .star-two {
    top: 180px;
    right: 28px;
    color: #df8e4c;
  }

  .star-three {
    top: 68px;
    right: 55px;
    color: white;
  }

  .speech-bubble {
    position: absolute;
    z-index: 4;
    top: 74px;
    left: 15px;
    padding: 12px;
    background: var(--paper);
    border: 2px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    font-family: "Press Start 2P", monospace;
    font-size: 8px;
