/* =========================================
   ARCADE FX: animaciones y microinteracciones
   ========================================= */

/* Entrada del personaje */

.avatar-art {
  animation:
    arcade-enter 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both,
    arcade-float 4s ease-in-out 700ms infinite;
  transform-origin: bottom center;
  position: absolute;
  left: 50%;
  margin-left: -90px;
  will-change: transform;
}

/* Las tarjetas aparecen de forma escalonada */
.project-card {
  animation: arcade-reveal 450ms ease-out both;
}

.project-card:nth-child(2) {
  animation-delay: 100ms;
}

.project-card:nth-child(3) {
  animation-delay: 200ms;
}

/* Reacción de las tarjetas */
.project-card {
  transition:
    transform 160ms steps(3, end),
    box-shadow 160ms steps(3, end),
    background-color 160ms ease;
}

.project-card:hover {
  transform: translate(3px, 3px);
  box-shadow: 2px 2px 0 var(--ink);
}

.project-card:focus-within {
  outline: 3px solid var(--purple);
  outline-offset: 4px;
}

/* El icono responde al cursor */
.project-icon {
  transition: transform 180ms steps(4, end);
}

.project-card:hover .project-icon {
  transform: translateY(-4px) scale(1.08);
}

/* Los enlaces se sienten como botones de selección */
.project-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition:
    gap 160ms ease,
    color 160ms ease;
}

.project-link:hover {
  gap: 11px;
  color: var(--purple-dark);
}

.project-link:focus-visible {
  outline: 2px dashed var(--purple);
  outline-offset: 5px;
}

/* Animaciones */

@keyframes arcade-enter {
  from {
    opacity: 0;
    transform: translateY(24px) scale(0.94);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes arcade-float {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-6px);
  }
}

@keyframes arcade-reveal {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

/* Respeta a quienes prefieren menos movimiento */
@media (prefers-reduced-motion: reduce) {
  .avatar-art,
